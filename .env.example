# Docker Compose defaults work without an .env file.
CREDIT_API_PORT=8000
CREDIT_DISPATCH_LEASE_SECONDS=30
CREDIT_DISPATCH_BACKOFF_MAX_SECONDS=300
CREDIT_TASK_RETRY_BASE_SECONDS=2
CREDIT_TASK_RETRY_MAX_SECONDS=60
CREDIT_TASK_MAX_FAILURES=5
CREDIT_MONGO_TIMEOUT_MS=3000
CREDIT_MONGO_SOCKET_TIMEOUT_MS=10000
# For a host-based Python process, configure CREDIT_MONGO_URI and CREDIT_BROKER_URL
# for reachable infrastructure. Compose intentionally keeps MongoDB/AMQP internal.
